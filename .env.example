# ============================
# VideoRAG Environment Config
# Hybrid 3-Step Architecture
# ============================

# ---------- General ----------
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# ---------- Backend (FastAPI) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=videorag
POSTGRES_USER=videorag_user
POSTGRES_PASSWORD=your-db-password

# ---------- Step 1: Indexing ----------
WHISPER_MODEL=large-v3
VISUAL_TAGGER_MODEL=yolov8n.pt

# ---------- Step 2: Retrieval (cheap standard LLM) ----------
STANDARD_LLM_PROVIDER=llama
# Options: llama (local), openai (GPT-4o-mini), gemini (Flash)
LLAMA_MODEL_PATH=./models/llama-3.1-8b-instruct.gguf

# ---------- Step 3: Multimodal LLM (expensive, targeted) ----------
MULTIMODAL_LLM_PROVIDER=gemini
# Options: gemini (Gemini 1.5 Pro), openai (GPT-4o)
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key

# ---------- Embedding Model ----------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ---------- Qdrant Vector Store ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=videorag_chunks
# QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key
# QDRANT_PATH=./data/qdrant_storage

# ---------- Clip Extraction ----------
CLIP_OUTPUT_DIR=./data/clips
CLIP_DURATION_SECONDS=30

# ---------- Data Paths ----------
VIDEO_UPLOAD_DIR=./data/videos
AUDIO_DIR=./data/audio
TRANSCRIPTS_DIR=./data/transcripts
VISUAL_TAGS_DIR=./data/visual_tags
EMBEDDINGS_DIR=./data/embeddings
METADATA_DIR=./data/metadata
