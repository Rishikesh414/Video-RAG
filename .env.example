# ============================
# VideoRAG Environment Config
# ============================

# ---------- General ----------
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# ---------- Backend (FastAPI) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=videorag
POSTGRES_USER=videorag_user
POSTGRES_PASSWORD=your-db-password

# ---------- LLM Provider ----------
# Options: llama, openai, gemini
LLM_PROVIDER=llama
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
LLAMA_MODEL_PATH=./models/llama-3.1-8b-instruct

# ---------- Embedding Model ----------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ---------- Whisper ASR ----------
WHISPER_MODEL=large-v3

# ---------- FAISS ----------
FAISS_INDEX_PATH=./data/faiss_index

# ---------- Video Processing ----------
MAX_KEYFRAMES=32
FRAME_EXTRACTION_FPS=1

# ---------- Data Paths ----------
VIDEO_UPLOAD_DIR=./data/videos
FRAMES_DIR=./data/frames
AUDIO_DIR=./data/audio
TRANSCRIPTS_DIR=./data/transcripts
OCR_OUTPUT_DIR=./data/ocr_output
EMBEDDINGS_DIR=./data/embeddings
METADATA_DIR=./data/metadata
